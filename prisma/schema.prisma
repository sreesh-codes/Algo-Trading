generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String?
  emailVerified DateTime?
  image         String?
  role          String    @default("CANDIDATE")
  isActive      Boolean   @default(true)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  accounts         Account[]
  sessions         Session[]
  candidateProfile CandidateProfile?
  submissions      Submission[]
  finalEvaluation  FinalEvaluation?

  auditLogsPerformed AuditLog[] @relation("AdminUser")
  auditLogsTargeted  AuditLog[] @relation("TargetUser")
}

model CandidateProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  university         String?
  studentId          String?
  degree             String?
  graduationYear     String?
  phone              String?
  country            String?
  
  registrationStatus String   @default("PENDING")
  registeredAt       DateTime @default(now())
  
  githubUsername     String?
  codingExperience   String?
  quantExperience    String?
  
  agreedToTerms      Boolean  @default(false)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AuditLog {
  id           String   @id @default(cuid())
  adminUserId  String
  adminUser    User     @relation("AdminUser", fields: [adminUserId], references: [id], onDelete: Cascade)
  
  targetUserId String?
  targetUser   User?    @relation("TargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  
  action       String
  metadata     String?
  ipAddress    String?
  
  createdAt    DateTime @default(now())
}

model CompetitionSettings {
  id                String    @id @default("global")
  competitionStatus String    @default("REGISTRATION_OPEN")
  competitionStart  DateTime?
  competitionEnd    DateTime?
  updatedAt         DateTime  @updatedAt
}

model Submission {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceCode  String
  sourceHash  String
  createdAt   DateTime @default(now())
  
  jobs             BacktestJob[]
  finalEvaluations FinalEvaluation[]
}

model BacktestJob {
  id           String   @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  status       String   @default("QUEUED") // QUEUED, RUNNING, COMPLETED, FAILED, TIMEOUT
  queueJobId   String?
  error        String?
  dataset      String   @default("DUBAI_OIL")
  symbol       String   @default("DUBAI_OIL")
  
  createdAt    DateTime @default(now())
  startedAt    DateTime?
  completedAt  DateTime?

  result       BacktestResult?
}

model BacktestResult {
  id                String   @id @default(cuid())
  jobId             String   @unique
  job               BacktestJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  totalPnl          Float
  realizedPnl       Float
  unrealizedPnl     Float
  maxDrawdown       Float
  tradeCount        Int
  
  statistics        String // JSON representation
  equityCurve       String // JSON representation
  finalPositions    String // JSON representation
  
  engineVersion     String
  datasetVersion    String
  configurationHash String
  runtime           Int
}

model PrivateScenario {
  id           String   @id @default(cuid())
  name         String
  datasetFile  String   // e.g. "DUNE_ENERGY" base, or just the scenario string "mean_reversion"
  weight       Float    @default(0.2)
  regimeType   String   // MeanReversion, Momentum, Volatile, etc
  seed         Int
  
  runs         EvaluationRun[]
}

model FinalEvaluation {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissionId    String
  submission      Submission @relation(fields: [submissionId], references: [id])
  
  publicScore     Float
  privateScore    Float?
  finalScore      Float?
  status          String   @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED
  
  runs            EvaluationRun[]
}

model EvaluationRun {
  id                String   @id @default(cuid())
  finalEvaluationId String
  finalEvaluation   FinalEvaluation @relation(fields: [finalEvaluationId], references: [id], onDelete: Cascade)
  scenarioId        String
  scenario          PrivateScenario @relation(fields: [scenarioId], references: [id])
  jobId             String? // maps to BacktestJob or similar worker job
  
  pnl               Float?
  maxDrawdown       Float?
  tradeCount        Int?
  status            String   @default("PENDING") // QUEUED, RUNNING, COMPLETED, FAILED
}
